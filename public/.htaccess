RewriteEngine On
RewriteRule ^\.builds - [F,L]

# Redirect explicit index.html requests without looping on DirectoryIndex.
RewriteCond %{THE_REQUEST} \s/+([^?\s]*/)?index\.html(?:[?\s])
RewriteRule ^(.*/)?index\.html$ https://carpinteriaraycocaceres.com/%1 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^www\.carpinteriaraycocaceres\.com$ [NC]
RewriteRule ^ https://carpinteriaraycocaceres.com%{REQUEST_URI} [R=301,L,NE]
