---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404: No Encontrado">
  <main id="contenido" tabindex="-1" class="shell section-pad flex flex-col items-center justify-center text-center">
    <p class="eyebrow">Error 404</p>
    <h1 class="section-heading">Página no encontrada</h1>
    <p class="text-stone-600 dark:text-stone-400 mt-2 mb-8">
      Lo sentimos, la página que buscas no existe o ha sido movida.
    </p>
    <a href="/" class="button">
      Volver al Inicio
    </a>
  </main>
</BaseLayout>
