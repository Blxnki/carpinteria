---
import { Image, getImage } from 'astro:assets';
import { GALLERY_DATA } from '../data/gallery';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const copy = lang === 'en'
  ? {
      eyebrow: 'Made with care',
      title: 'The details make the difference.',
      intro: 'Wood, light and spaces that work. Explore a selection of our carpentry, restoration and outdoor projects.',
      view: 'View project',
      more: 'Show more projects',
      less: 'Show fewer projects',
      count: '32 photographs. Real work.',
      close: 'Close image viewer',
      previous: 'Previous photograph',
      next: 'Next photograph',
      viewer: 'Project photographs',
    }
  : {
      eyebrow: 'Trabajos con oficio',
      title: 'La diferencia está en los detalles.',
      intro: 'Madera, luz y espacios que funcionan. Una selección de nuestros trabajos de carpintería, restauración y exteriores.',
      view: 'Ver proyecto',
      more: 'Mostrar más trabajos',
      less: 'Mostrar menos trabajos',
      count: '32 fotografías. Trabajos reales.',
      close: 'Cerrar visor de imágenes',
      previous: 'Fotografía anterior',
      next: 'Siguiente fotografía',
      viewer: 'Fotografías de los trabajos',
    };

const projects = await Promise.all(GALLERY_DATA.map(async (item) => {
  const preview = await getImage({
    src: item.src,
    width: Math.min(item.src.width, 1200),
    format: 'webp',
    quality: 82,
  });
  return { ...item, preview: preview.src };
}));
---

<section id="galeria" class="gallery section-pad" aria-labelledby="gallery-heading">
  <div class="shell">
    <div class="gallery-heading">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h2 id="gallery-heading" class="section-heading">{copy.title}</h2>
      </div>
      <p class="gallery-intro">{copy.intro}</p>
    </div>

    <div id="gallery-grid" class="gallery-grid">
      {projects.map((item, index) => (
        <article class="gallery-project" hidden={index >= 6}>
          <a
            class="project-link"
            href={item.preview}
            data-project-index={index}
            data-title={item.title[lang]}
            data-category={item.category[lang]}
            data-alt={item.alt[lang]}
            aria-label={`${copy.view}: ${item.title[lang]}`}
          >
            <div class="project-image">
              <Image
                src={item.src}
                alt={item.alt[lang]}
                widths={[360, 600, 900]}
                sizes="(max-width: 620px) calc(100vw - 40px), (max-width: 960px) calc((100vw - 72px) / 2), 390px"
                width={600}
                height={700}
                fit="cover"
                format="webp"
                quality={76}
                loading="lazy"
                decoding="async"
              />
              <span class="project-open" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18 18 6M6 6h12v12" /></svg>
              </span>
            </div>
            <div class="project-caption">
              <div>
                <p class="project-category">{item.category[lang]}</p>
                <h3>{item.title[lang]}</h3>
              </div>
              <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <div class="gallery-footer">
      <p>{copy.count}</p>
      <button
        id="gallery-more"
        class="button button-outline"
        aria-controls="gallery-grid"
        aria-expanded="false"
        data-more={copy.more}
        data-less={copy.less}
        hidden
      >
        <span>{copy.more}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
      </button>
    </div>
  </div>

  <dialog id="gallery-viewer" class="gallery-viewer" aria-label={copy.viewer} aria-describedby="gallery-viewer-title">
    <div class="viewer-top">
      <span id="gallery-viewer-counter" class="viewer-counter" aria-live="polite"></span>
      <button class="viewer-control viewer-close" data-viewer-close aria-label={copy.close} autofocus>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </div>
    <div class="viewer-stage">
      <button class="viewer-control viewer-prev" data-viewer-prev aria-label={copy.previous}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 5-7 7 7 7" /></svg>
      </button>
      <img id="gallery-viewer-image" alt="" width="1200" height="1200" decoding="async" />
      <button class="viewer-control viewer-next" data-viewer-next aria-label={copy.next}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 5 7 7-7 7" /></svg>
      </button>
    </div>
    <div class="viewer-caption">
      <p id="gallery-viewer-category"></p>
      <p id="gallery-viewer-title"></p>
    </div>
  </dialog>

  <noscript>
    <style is:inline>#galeria .gallery-project[hidden] { display: block !important; }</style>
  </noscript>
</section>

<style>
  .gallery { background: var(--paper); }
  .gallery-heading { display: grid; grid-template-columns: 1.35fr 0.65fr; gap: 70px; align-items: end; margin-bottom: 46px; }
  .gallery-heading h2 { max-width: 670px; margin-bottom: 0; }
  .gallery-intro { max-width: 340px; margin: 0 0 5px auto; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 28px; row-gap: 40px; }
  .gallery-project[hidden] { display: none; }
  .project-link { display: block; color: var(--ink); text-decoration: none; }
  .project-image { position: relative; overflow: hidden; aspect-ratio: 6 / 7; background: var(--surface); }
  .project-image img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 500ms ease; }
  .project-open { position: absolute; right: 18px; bottom: 18px; display: grid; place-items: center; width: 44px; height: 44px; color: var(--ink); background: var(--paper); border-radius: 50%; transition: transform 250ms ease; }
  .project-open svg { width: 22px; height: 22px; }
  .project-link:hover .project-image img { transform: scale(1.035); }
  .project-link:hover .project-open { transform: rotate(45deg); }
  .project-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; }
  .project-caption { display: flex; justify-content: space-between; gap: 14px; align-items: start; padding-top: 18px; }
  .project-category { margin: 0 0 7px; color: var(--accent); text-transform: uppercase; font-size: 10px; letter-spacing: 0.12em; font-weight: 600; line-height: 1.5; }
  .project-caption h3 { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 22px; font-weight: 400; line-height: 1.3; }
  .project-number { padding-top: 2px; color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .gallery-footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 46px; padding-top: 30px; border-top: 1px solid var(--line); }
  .gallery-footer p { margin: 0; color: var(--muted); font-size: 13px; }
  .gallery-footer button { gap: 14px; cursor: pointer; }
  .gallery-footer button[hidden] { display: none; }
  .gallery-footer button svg { width: 18px; height: 18px; }
  .gallery-footer button[aria-expanded='true'] svg { transform: rotate(45deg); }
  .gallery-viewer { position: fixed; inset: 0; width: min(1120px, calc(100vw - 48px)); max-width: none; max-height: calc(100dvh - 48px); margin: auto; padding: 22px 26px 26px; color: var(--ink); background: var(--paper); border: 1px solid var(--line); }
  .gallery-viewer::backdrop { background: rgb(15 19 13 / 86%); backdrop-filter: blur(5px); }
  .viewer-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 16px; }
  .viewer-counter { color: var(--muted); font-size: 12px; letter-spacing: 0.1em; font-variant-numeric: tabular-nums; }
  .viewer-control { display: grid; place-items: center; flex: 0 0 44px; width: 44px; height: 44px; padding: 10px; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 50%; cursor: pointer; }
  .viewer-control:hover { color: var(--paper); background: var(--accent); }
  .viewer-control:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .viewer-control svg { width: 23px; height: 23px; }
  .viewer-stage { display: flex; gap: 20px; align-items: center; justify-content: space-between; }
  .viewer-stage img { display: block; width: calc(100% - 128px); height: min(65dvh, 690px); object-fit: contain; }
  .viewer-caption { margin: 20px 64px 0; }
  .viewer-caption p:first-child { margin: 0 0 5px; color: var(--accent); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; }
  .viewer-caption p:last-child { margin: 0; font-family: Georgia, 'Times New Roman', serif; font-size: 25px; line-height: 1.3; }
  @media (max-width: 960px) {
    .gallery-heading { grid-template-columns: 1fr; gap: 22px; margin-bottom: 34px; }
    .gallery-intro { margin: 0; max-width: 570px; }
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px 24px; }
  }
  @media (max-width: 620px) {
    .gallery-grid { grid-template-columns: 1fr; row-gap: 30px; }
    .project-image { aspect-ratio: 1; }
    .gallery-footer { flex-direction: column; align-items: start; gap: 20px; margin-top: 34px; }
    .gallery-viewer { width: calc(100vw - 20px); max-height: calc(100dvh - 20px); padding: 14px; }
    .viewer-stage { position: relative; display: block; padding-bottom: 58px; }
    .viewer-stage img { width: 100%; height: 57dvh; }
    .viewer-prev, .viewer-next { position: absolute; bottom: 0; }
    .viewer-prev { left: calc(50% - 54px); }
    .viewer-next { right: calc(50% - 54px); }
    .viewer-caption { margin: 18px 0 0; }
    .viewer-caption p:last-child { font-size: 23px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-image img, .project-open { transition: none; }
  }
</style>

<script>
  const gallery = document.getElementById('galeria');
  const viewer = gallery?.querySelector<HTMLDialogElement>('#gallery-viewer');
  const image = gallery?.querySelector<HTMLImageElement>('#gallery-viewer-image');
  const title = gallery?.querySelector<HTMLElement>('#gallery-viewer-title');
  const category = gallery?.querySelector<HTMLElement>('#gallery-viewer-category');
  const counter = gallery?.querySelector<HTMLElement>('#gallery-viewer-counter');
  const more = gallery?.querySelector<HTMLButtonElement>('#gallery-more');
  const links = Array.from(gallery?.querySelectorAll<HTMLAnchorElement>('[data-project-index]') ?? []);
  const extraProjects = Array.from(gallery?.querySelectorAll<HTMLElement>('.gallery-project[hidden]') ?? []);

  if (gallery && viewer && image && title && category && counter && more) {
    let currentIndex = 0;
    let opener: HTMLElement | null = null;
    let expanded = false;
    let previousOverflow = '';

    const showImage = (index: number) => {
      currentIndex = (index + links.length) % links.length;
      const link = links[currentIndex];
      image.src = link.href;
      image.alt = link.dataset.alt ?? '';
      title.textContent = link.dataset.title ?? '';
      category.textContent = link.dataset.category ?? '';
      counter.textContent = `${String(currentIndex + 1).padStart(2, '0')} / ${links.length}`;
    };

    more.hidden = false;
    more.addEventListener('click', () => {
      expanded = !expanded;
      extraProjects.forEach((project) => { project.hidden = !expanded; });
      more.setAttribute('aria-expanded', String(expanded));
      const label = more.querySelector('span');
      if (label) label.textContent = (expanded ? more.dataset.less : more.dataset.more) ?? '';
      if (expanded) {
        extraProjects[0]?.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        more.focus({ preventScroll: true });
        more.scrollIntoView({ block: 'nearest', behavior: 'instant' });
      }
    });

    gallery.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('[data-project-index]');
      if (!link || (event as MouseEvent).button !== 0 || (event as MouseEvent).ctrlKey || (event as MouseEvent).metaKey || (event as MouseEvent).shiftKey || (event as MouseEvent).altKey) return;
      event.preventDefault();
      opener = link;
      showImage(Number(link.dataset.projectIndex));
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      viewer.showModal();
    });

    viewer.querySelector('[data-viewer-close]')?.addEventListener('click', () => viewer.close());
    viewer.querySelector('[data-viewer-prev]')?.addEventListener('click', () => showImage(currentIndex - 1));
    viewer.querySelector('[data-viewer-next]')?.addEventListener('click', () => showImage(currentIndex + 1));
    viewer.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        showImage(currentIndex + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    viewer.addEventListener('click', (event) => {
      if (event.target !== viewer) return;
      const bounds = viewer.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) viewer.close();
    });
    viewer.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      image.removeAttribute('src');
      opener?.focus({ preventScroll: true });
    });
  }
</script>
