---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Image } from "astro:assets";
import workshopImage from "../assets/images/carpinteria/19.jpeg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEnglish = lang === "en";
---

<section id="sobre-nosotros" class="about section-pad" aria-labelledby="about-heading">
  <div class="shell about-grid">
    <div class="about-visual">
      <Image
        src={workshopImage}
        alt={isEnglish ? "Detail of a timber pergola built by Rayco Cáceres in Lanzarote" : "Detalle de una pérgola de madera realizada por Rayco Cáceres en Lanzarote"}
        widths={[400, 640, 800, 1100]}
        width={1100}
        height={825}
        sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1280px) 46vw, 570px"
        class="about-image"
        loading="lazy"
        decoding="async"
        format="webp"
        quality={80}
      />
      <div class="heritage-badge">
        <span>{isEnglish ? "Crafting since" : "Trabajando desde"}</span>
        <strong>1998</strong>
        <span>Lanzarote</span>
      </div>
    </div>
    <div class="about-content">
      <p class="eyebrow">{t("about.title")}</p>
      <h2 id="about-heading" class="section-heading">
        {isEnglish ? "Wood is our craft." : "La madera es nuestro oficio."}
        <em>{isEnglish ? "Detail, our signature." : "El detalle, nuestra firma."}</em>
      </h2>
      <p class="about-lead">{isEnglish ? "A family workshop. A passion shared." : "Un taller familiar. Una pasión compartida."}</p>
      <p>{t("about.content1")}</p>
      <p>{t("about.content2")}</p>
      <a href="#contacto" class="text-link">
        {isEnglish ? "Let's talk about your project" : "Hablemos de tu proyecto"}
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 12h15m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .about { background: var(--surface); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 88px; align-items: center; }
  .about-visual { position: relative; aspect-ratio: .97; border-radius: 5px; }
  .about-image { width: 100%; height: 100%; object-fit: cover; object-position: 52% 45%; border-radius: 5px; }
  .heritage-badge { position: absolute; right: -22px; bottom: 30px; display: flex; align-items: center; flex-direction: column; justify-content: center; width: 158px; height: 158px; border: 1px solid var(--line); background: var(--paper); color: var(--ink); border-radius: 50%; }
  .heritage-badge span { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
  .heritage-badge strong { margin: 5px 0; font-family: Georgia, "Times New Roman", serif; font-size: 42px; line-height: 1.15; font-weight: 400; }
  .about-content .section-heading { font-size: clamp(34px, 3.6vw, 48px); line-height: 1.13; margin-bottom: 26px; }
  .section-heading em { display: block; font-weight: inherit; color: var(--accent); }
  .about-content p:not(.eyebrow) { color: var(--muted); font-size: 15px; line-height: 1.85; margin: 0 0 16px; }
  .about-content p.about-lead { color: var(--ink); font-weight: 500; font-size: 16px; }
  .about-content .text-link { display: inline-flex; align-items: center; gap: 20px; margin-top: 14px; }
  @media (max-width: 1000px) { .about-grid { gap: 48px; } .heritage-badge { width: 136px; height: 136px; right: -16px; } }
  @media (max-width: 760px) {
    .about-grid { grid-template-columns: 1fr; gap: 42px; }
    .about-visual { aspect-ratio: 1.2; max-height: 500px; }
    .heritage-badge { right: 20px; bottom: -18px; width: 124px; height: 124px; }
    .heritage-badge strong { font-size: 34px; }
    .heritage-badge span { font-size: 9px; }
    .about-content .section-heading { font-size: clamp(34px, 7vw, 48px); }
  }
</style>
