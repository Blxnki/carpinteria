---
import { COMPANY_DATA } from '../data/company';
import { getLangFromUrl } from '../i18n/utils';

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
const isEnglish = getLangFromUrl(Astro.url) === 'en';
const profiles = [
  { name: 'Facebook', href: COMPANY_DATA.social.facebook, icon: 'facebook' },
  { name: 'Instagram', href: COMPANY_DATA.social.instagram, icon: 'instagram' },
  { name: 'TikTok', href: COMPANY_DATA.social.tiktok, icon: 'tiktok' },
];
---

<nav class:list={['social-links', { light }]} aria-label={isEnglish ? 'Social media' : 'Redes sociales'}>
  {profiles.map(({ name, href, icon }) => (
    <a href={href} target="_blank" rel="noopener noreferrer" aria-label={`${name} (${isEnglish ? 'opens in a new tab' : 'se abre en una pestaña nueva'})`}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        {icon === 'facebook' && <path fill="currentColor" d="M13.5 22v-9h3l.5-3.5h-3.5V7.25c0-1.01.28-1.7 1.74-1.7H17V2.42A23.7 23.7 0 0 0 14.44 2C11.91 2 10 3.54 10 6.37V9.5H7V13h3v9h3.5Z" />}
        {icon === 'instagram' && <>
          <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7" />
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.7" />
          <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" />
        </>}
        {icon === 'tiktok' && <path fill="currentColor" d="M16.7 2h-3.2v13.2a3 3 0 1 1-2.6-3V8.9a6.3 6.3 0 1 0 5.8 6.3V8.5a8.1 8.1 0 0 0 4.8 1.6V6.9A4.8 4.8 0 0 1 16.7 2Z" />}
      </svg>
      <span>{name}</span>
    </a>
  ))}
</nav>

<style>
  .social-links { display: flex; flex-wrap: wrap; gap: 8px; }
  .social-links a { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 44px; padding: 9px 11px; border: 1px solid var(--line); border-radius: 4px; color: var(--ink); font-size: .78rem; line-height: 1.2; text-decoration: none; transition: color .2s ease, border-color .2s ease, background-color .2s ease; }
  .social-links svg { width: 17px; height: 17px; flex: none; }
  .social-links a:hover { color: var(--accent); border-color: var(--accent); }
  .social-links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .social-links.light a { color: #f7f5ef; border-color: #64705d; }
  .social-links.light a:hover { background: #f7f5ef; border-color: #f7f5ef; color: #303d2e; }
  .social-links.light a:focus-visible { outline-color: #f7f5ef; }
  @media (prefers-reduced-motion: reduce) { .social-links a { transition: none; } }
</style>
