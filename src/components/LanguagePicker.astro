---
import { languages } from '../i18n/ui';
import { getLangFromUrl } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const routes: Record<string, { es: string; en: string }> = {
  '/aviso-legal': { es: '/aviso-legal/', en: '/en/legal-notice/' },
  '/en/legal-notice': { es: '/aviso-legal/', en: '/en/legal-notice/' },
  '/politica-privacidad': { es: '/politica-privacidad/', en: '/en/privacy-policy/' },
  '/en/privacy-policy': { es: '/politica-privacidad/', en: '/en/privacy-policy/' },
};
const current = Astro.url.pathname.replace(/\/$/, '');
const destinations = routes[current] || { es: '/', en: '/en/' };
---
<nav class="language-picker" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
  {Object.entries(languages).map(([code, label]) => <a href={destinations[code as 'es' | 'en']} lang={code} hreflang={code} aria-label={label} aria-current={lang === code ? 'page' : undefined} class:list={{ selected: lang === code }}>{code.toUpperCase()}</a>)}
</nav>
<style>
  .language-picker { display: flex; align-items: center; gap: 1px; }
  a { display: flex; align-items: center; justify-content: center; width: 31px; min-height: 36px; font-size: 10px; font-weight: 600; color: var(--muted); border-radius: 3px; }
  a:hover { color: var(--accent); background: var(--tint); }
  a.selected { color: var(--ink); text-decoration: underline; text-underline-offset: 5px; text-decoration-color: var(--accent); }
</style>
